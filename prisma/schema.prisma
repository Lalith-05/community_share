generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  profileImage  String?
  bio           String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         Item[]
  requests      BorrowRequest[]
  reviews       Review[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?

  items     Item[]
}

model Item {
  id              String   @id @default(cuid())
  title           String
  description     String
  imageUrls       String[]
  availability    Boolean  @default(true)
  depositAmount   Float
  maxBorrowDays   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownerId         String
  owner           User @relation(fields: [ownerId], references: [id])

  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  requests        BorrowRequest[]
  reviews         Review[]
}

model BorrowRequest {
  id           String   @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  status       String   @default("PENDING")
  message      String?
  createdAt    DateTime @default(now())

  itemId       String
  item         Item @relation(fields: [itemId], references: [id])

  borrowerId   String
  borrower     User @relation(fields: [borrowerId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String
  createdAt    DateTime @default(now())

  reviewerId   String
  reviewer     User @relation(fields: [reviewerId], references: [id])

  itemId       String
  item         Item @relation(fields: [itemId], references: [id])
}